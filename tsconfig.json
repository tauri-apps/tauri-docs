{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@fragments/*": ["./src/content/docs/_fragments/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "exclude": ["dist", "packages", "src/data/tutorials"]
}
