{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@fragments/*": ["./src/content/docs/_fragments/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "noUncheckedIndexedAccess": true
  },
}
