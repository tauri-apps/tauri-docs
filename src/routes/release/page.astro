---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import UntranslatedNotice from '../../components/releases/UntranslatedNotice.astro';
import { releaseSidebar } from '../../../packages/releases-site/generator/config';
import '../../styles/releases.scss';

export const getStaticPaths = (async () => {
  const entries = await getCollection('releases');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug || undefined },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { slug, ...frontmatter } = entry.data;
---

<StarlightPage frontmatter={frontmatter} headings={headings} sidebar={releaseSidebar}>
  <UntranslatedNotice />
  <Content />
</StarlightPage>

<script>
  import { readRememberedLocale } from '../../components/locale-memory';
  import { applyReleaseLocale } from '../../components/releases/release-locale';

  applyReleaseLocale(readRememberedLocale());
</script>
