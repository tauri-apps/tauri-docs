---
import { Image } from 'astro:assets';
import crabNebulaImage from '../../../.github/sponsors/crabnebula.svg';

interface Partner {
  name: string;
  image?: ImageMetadata;
  // https://docs.astro.build/en/guides/images/#svg-components
  svg?: ((_props: astroHTML.JSX.SVGAttributes) => any) & ImageMetadata;
  url: string;
}

const officialPartners: Partner[] = [
  {
    name: 'CrabNebula',
    svg: crabNebulaImage,
    url: 'https://crabnebula.dev/',
  },
];

const partners: Partner[] = [
  {
    name: 'Netlify',
    url: 'https://www.netlify.com/',
  },
  {
    name: 'Meilisearch',
    url: 'https://www.meilisearch.com/',
  },
];

function renderImage(partner: Partner) {
  if (partner.svg) {
    return <partner.svg class="partner-svg" />;
  } else if (partner.image) {
    return <Image src={partner.image} inferSize alt={partner.name} />;
  }
  return null;
}
---

{
  (
    <div class="partners">
      {officialPartners.map((partner) => (
        <div class="partner official not-content">
          {renderImage(partner)}
          <a href={partner.url} target="_blank" rel="noopener noreferrer">
            {partner.name}
          </a>
        </div>
      ))}
      {partners.map((partner) => (
        <div class="partner not-content">
          <a href={partner.url} target="_blank" rel="noopener noreferrer">
            {partner.name}
          </a>
          {renderImage(partner)}
        </div>
      ))}
    </div>
  )
}

<style>
  .service-providers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .service-provider {
    padding: 1rem;
    border: 4px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg-nav);
  }

  .service-provider a {
    font-weight: 600;
    color: var(--sl-color-text);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
  }

  .service-provider a:hover {
    color: var(--sl-color-accent);
  }
</style>
