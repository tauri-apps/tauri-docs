---
import OpenCollective from './OpenCollective/Collective.astro';
import GitHubSponsor from './GitHub/Sponsors.astro';
import Partners from './Partners.astro';
---

<div class="not-content" style="margin-top: 4rem;">
  <section class="sponsors-section">
    <h2>Many thanks to</h2>
    <div class="funding-source">
      <h4>Our Open Collective contributors</h4>
      <OpenCollective />
    </div>
    <div class="funding-source">
      <h4>Our GitHub sponsors</h4>
      <GitHubSponsor />
    </div>
  </section>

  <section class="partners-section">
    <h2>Supported by</h2>
    <Partners />
  </section>
</div>

<style>
  /* todo: add styles for headings h2, h3, h4 */
  h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: bold;
  }

  h4 {
    /* border 50% opacity */
    border-bottom: 1px solid var(--sl-color-gray-6);
    margin-bottom: 0.5rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  section {
    margin-bottom: 4rem;
  }

  .funding-source {
    margin-bottom: 4rem;
  }
</style>
