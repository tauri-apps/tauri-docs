---
import communityResourcesData from '../data/communityResources.json';
import { Icon } from '@astrojs/starlight/components';
import type { Resource } from 'packages/community-resources/transform';

const resources = communityResourcesData.resources as Resource[];

// star counts need a token, so the workflow populates them on its first run -
// until then the column and its sort option would be dead UI
const hasStars = resources.some((item) => typeof item.stars === 'number');

const { locale } = Astro.locals.starlightRoute;
const backHref = locale ? `/${locale}/plugin/` : '/plugin/';

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const numberFormat = new Intl.NumberFormat('en-US');

// depends on /assets/registries.svg
const links = [
  { key: 'repository', icon: 'cr-github', title: 'Repository' },
  { key: 'crates_io', icon: 'cr-crate', title: 'crates.io' },
  { key: 'npm', icon: 'cr-npm', title: 'npm' },
] as const;
---

<p>
  <a href={backHref}><Icon name="left-arrow" class="inline" />Plugins</a>
</p>

<community-resources>
  <div class="search-container">
    <input
      type="text"
      id="resource-search"
      placeholder="Search plugins by name or description..."
      aria-label="Search community plugins by name or description"
      class="search-input"
      autocomplete="off"
    />
    <div class="filters">
      <label>
        <span>Source:</span>
        <select id="filter-source" class="filter-select">
          <option value="">All</option>
          <option value="both">Both (npm & crates)</option>
          <option value="npm">npm only</option>
          <option value="crates">crates only</option>
        </select>
      </label>
      <label>
        <span>Sort by:</span>
        <select id="sort-by" class="filter-select">
          <option value="date">Date Created</option>
          <option value="name">Name</option>
          {hasStars && <option value="stars">Stars</option>}
        </select>
      </label>
    </div>
    <div class="summary" aria-live="polite">
      Showing <strong id="visible-count">{resources.length}</strong> of <strong
        >{resources.length}</strong
      > community plugins
    </div>
  </div>

  <div class="table-wrapper">
    <table class:list={['resources-table', { 'no-stars': !hasStars }]}>
      <caption class="sr-only"> Community plugins published to crates.io and npm </caption>
      <thead>
        <tr>
          <th class="name-header">Name & Links</th>
          <th class="description-header">Description</th>
          {hasStars && <th class="stars-header">Stars</th>}
          <th class="created-header">Created</th>
        </tr>
      </thead>
      <tbody id="resources-tbody">
        {
          resources.map((item) => (
            <tr
              class="resource-row"
              data-source={item.npm && item.crates_io ? 'both' : item.npm ? 'npm' : 'crates'}
              data-stars={typeof item.stars === 'number' ? String(item.stars) : undefined}
            >
              <td class="name-cell">
                <div class="name-with-links">
                  <code>{item.name}</code>
                  <div class="links">
                    {links.map(({ key, icon, title }) =>
                      item[key] ? (
                        <a
                          href={item[key]}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={title}
                          aria-label={`${item.name} on ${title}`}
                        >
                          <svg class="link-icon" aria-hidden="true">
                            <use xlink:href={`/assets/registries.svg#${icon}`} />
                          </svg>
                        </a>
                      ) : null
                    )}
                  </div>
                </div>
              </td>
              <td class="description-cell">{item.description}</td>
              {hasStars && (
                <td class="stars-cell">
                  {typeof item.stars === 'number' ? numberFormat.format(item.stars) : '-'}
                </td>
              )}
              <td class="created-cell">
                {item.created_at ? dateFormat.format(new Date(item.created_at)) : '-'}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="no-results hidden" id="no-results">No plugins match your search criteria.</div>
</community-resources>

<style>
  .inline {
    display: inline-block;
    vertical-align: middle;
  }

  community-resources {
    display: block;
    width: 100%;
  }

  .search-container {
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    margin-bottom: 1rem;
    box-sizing: border-box;
  }

  .search-input:focus {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 0;
  }

  .filters {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 1rem;
  }

  .filters label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .filter-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    cursor: pointer;
    font-size: 0.9rem;
  }

  .summary {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 1rem;
  }

  .table-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .resources-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    table-layout: fixed;
  }

  .resources-table th,
  .resources-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  .resources-table thead {
    background: var(--sl-color-gray-6);
  }

  .resources-table th {
    font-weight: 600;
  }

  .name-header,
  .name-cell {
    width: 25%;
  }

  .description-header,
  .description-cell {
    width: 50%;
  }

  .no-stars .description-header,
  .no-stars .description-cell {
    width: 60%;
  }

  .stars-header,
  .stars-cell {
    width: 10%;
    text-align: right;
    white-space: nowrap;
  }

  .created-header,
  .created-cell {
    width: 15%;
    text-align: right;
    white-space: nowrap;
  }

  .resources-table tbody tr:last-child td {
    border-bottom: none;
  }

  .resources-table tbody tr:hover {
    background: var(--sl-color-gray-7);
  }

  .name-cell {
    white-space: nowrap;
  }

  .name-with-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .name-cell code {
    font-size: 0.85rem;
    background: transparent;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .description-cell {
    line-height: 1.4;
    word-wrap: break-word;
  }

  .links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .links a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s;
  }

  .links a:hover {
    opacity: 0.7;
  }

  .link-icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  .no-results {
    padding: 3rem;
    text-align: center;
    color: var(--sl-color-gray-3);
    font-size: 1.1rem;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .resources-table {
      font-size: 0.8rem;
    }

    .resources-table th,
    .resources-table td {
      padding: 0.5rem;
    }

    .description-cell {
      max-width: 200px;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  interface RowData {
    el: HTMLTableRowElement;
    index: number;
    name: string;
    description: string;
    stars: number;
    source: string;
  }

  class CommunityResources extends HTMLElement {
    searchInput: HTMLInputElement;
    sourceFilter: HTMLSelectElement;
    sortSelect: HTMLSelectElement;
    tbody: HTMLElement;
    tableWrapper: HTMLElement;
    visibleCountEl: HTMLElement;
    noResultsEl: HTMLElement;
    cachedRows: RowData[] | undefined;
    searchTimer: number | undefined;

    constructor() {
      super();

      this.searchInput = this.querySelector('#resource-search') as HTMLInputElement;
      this.sourceFilter = this.querySelector('#filter-source') as HTMLSelectElement;
      this.sortSelect = this.querySelector('#sort-by') as HTMLSelectElement;
      this.tbody = this.querySelector('#resources-tbody') as HTMLElement;
      this.tableWrapper = this.querySelector('.table-wrapper') as HTMLElement;
      this.visibleCountEl = this.querySelector('#visible-count') as HTMLElement;
      this.noResultsEl = this.querySelector('#no-results') as HTMLElement;

      this.searchInput.addEventListener('input', () => {
        clearTimeout(this.searchTimer);
        this.searchTimer = setTimeout(() => this.update(), 150);
      });
      this.sourceFilter.addEventListener('change', () => this.update());
      this.sortSelect.addEventListener('change', () => {
        this.sort(this.sortSelect.value);
        this.update();
      });
    }

    // indexing 479 rows is only worth paying for once the reader interacts
    get rows(): RowData[] {
      this.cachedRows ??= Array.from(
        this.tbody.querySelectorAll<HTMLTableRowElement>('.resource-row')
      ).map((el, index) => ({
        el,
        index,
        name: el.querySelector('.name-cell code')?.textContent?.toLowerCase() || '',
        description: el.querySelector('.description-cell')?.textContent?.toLowerCase() || '',
        stars: el.dataset.stars ? Number(el.dataset.stars) : -1,
        source: el.dataset.source || '',
      }));
      return this.cachedRows;
    }

    matches(row: RowData, query: string, source: string) {
      if (query && !row.name.includes(query) && !row.description.includes(query)) {
        return false;
      }
      return !source || row.source === source;
    }

    // the DOM is kept in sort order at all times, so filtering only has to
    // toggle visibility. `index` is the server's created-desc order.
    sort(sortBy: string) {
      const ordered = [...this.rows];
      if (sortBy === 'name') {
        ordered.sort((a, b) => a.name.localeCompare(b.name));
      } else if (sortBy === 'stars') {
        ordered.sort((a, b) => b.stars - a.stars);
      } else {
        ordered.sort((a, b) => a.index - b.index);
      }

      const fragment = document.createDocumentFragment();
      for (const row of ordered) {
        fragment.appendChild(row.el);
      }
      this.tbody.appendChild(fragment);
    }

    update() {
      const query = this.searchInput.value.toLowerCase();
      const source = this.sourceFilter.value;
      let visibleCount = 0;

      for (const row of this.rows) {
        const visible = this.matches(row, query, source);
        row.el.classList.toggle('hidden', !visible);
        if (visible) visibleCount++;
      }

      this.visibleCountEl.textContent = visibleCount.toString();
      this.noResultsEl.classList.toggle('hidden', visibleCount > 0);
      this.tableWrapper.classList.toggle('hidden', visibleCount === 0);
    }
  }

  customElements.define('community-resources', CommunityResources);
</script>
