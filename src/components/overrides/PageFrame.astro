---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import Sidebar from 'virtual:starlight/components/Sidebar';

const route = Astro.locals.starlightRoute;
const isSplash = !route.hasSidebar;
route.hasSidebar = true;
---

<Default>
  <slot name="header" slot="header" />
  {isSplash ? <Sidebar slot="sidebar" /> : <slot name="sidebar" slot="sidebar" />}
  <slot />
</Default>

<style is:global>
  @media (min-width: 50rem) {
    html:not([data-has-sidebar]) nav.sidebar {
      display: none;
    }
  }
</style>
