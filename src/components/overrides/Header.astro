---
import LanguageSelect from './LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';

import links from '../../data/header-links.json';

const curLocale = Astro.locals.starlightRoute.locale;
const { topics } = Astro.locals.starlightSidebarTopics;

// A link marked `transfer: false` has no locale-prefixed URLs of its own, so the
// root locale inside that section means "no prefix here", not "the reader picked
// English". Recording it would wipe the locale. Omitting the
// attribute is what tells the script below to leave the locale
const isEnglishOnlySection = links.some(
  (link) => !link.transfer && Astro.url.pathname.startsWith(link.value)
);
---

<div class="header" data-locale={isEnglishOnlySection ? undefined : (curLocale ?? '')}>
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="desktop">
    {
      links.map((link) => {
        const href = link.transfer && curLocale ? `/${curLocale}${link.value}` : link.value;
        const topic = topics.find((topic) => topic.link === href);
        // /release/* is not a topic — it is served by its own routes — so fall
        // back to a path match for it.
        const current = topic?.isCurrent ?? Astro.url.pathname.startsWith(link.value);
        return (
          <a
            href={href}
            data-locale-link={link.transfer ? link.value : undefined}
            class:list={{ 'starlight-sidebar-topics-current': current }}
          >
            {topic?.label ?? link.title}
          </a>
        );
      })
    }
  </div>
  <div class="sl-flex search">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
  </div>
</div>

<script>
  import { rememberLocale } from '../locale-memory';

  const header = document.querySelector<HTMLElement>('.header[data-locale]');
  if (header) rememberLocale(header.dataset.locale ?? '');
</script>

<style>
  .header {
    display: grid;
    gap: var(--sl-nav-gap);
    align-content: center;
    height: 100%;
    grid-template-columns: auto 1fr 1fr auto;
  }

  @media (width < 50rem) {
    .header {
      grid-template-columns: 1fr auto;
    }
  }

  .search {
    justify-content: end;
  }

  .search,
  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
  @media (width >= 50rem) {
    .search::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }
  }

  a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  a.starlight-sidebar-topics-current {
    color: var(--sl-color-text-accent);
  }
  a:hover {
    color: var(--sl-color-gray-2);
  }
  :root[data-theme='light'] {
    .header a:hover {
      color: var(--sl-color-gray-3);
    }
  }

  .desktop {
    display: none;
    align-items: center;
    gap: 1rem;
    padding-inline-end: 1rem;
  }
  @media (width >= 50rem) {
    .desktop {
      display: flex;
    }
  }
</style>

<style is:global>
  .header {
    border: none !important;
  }
  body[data-mobile-menu-expanded] header {
    background-color: var(--sl-color-bg);
  }

  @media (width < 50rem) {
    header {
      /* We always show the sidebar on mobile */
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }
  }

  .title-wrapper img {
    height: 2rem;
  }
</style>
