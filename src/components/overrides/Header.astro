---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';

import links from '../../data/header-links.json';

const curLocale = Astro.locals.starlightRoute.locale;
const { topics } = Astro.locals.starlightSidebarTopics;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="desktop">
    {
      links.map((link) => {
        const href = link.transfer && curLocale ? `/${curLocale}${link.value}` : link.value;
        const topic = topics.find((topic) => topic.link === href);
        const current = topic?.isCurrent;
        return (
          <a href={href} class:list={{ 'starlight-sidebar-topics-current': current }}>
            {topic?.label ?? link.title}
          </a>
        );
      })
    }
  </div>
  <div class="sl-flex search">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
  </div>
</div>

<style>
  .header {
    display: grid;
    gap: var(--sl-nav-gap);
    align-content: center;
    height: 100%;
    grid-template-columns: auto 1fr 1fr auto;
  }

  @media (width <= 50rem) {
    .header {
      grid-template-columns: 1fr auto;
    }
  }

  .title-wrapper {
    /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
    overflow: clip;
    /* Avoid clipping focus ring around link inside title wrapper. */
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .search {
    justify-content: end;
  }

  .search,
  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
  @media (width > 50rem) {
    .search::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }
  }

  a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }
  a.starlight-sidebar-topics-current {
    color: var(--sl-color-text-accent);
  }
  a:hover {
    color: var(--sl-color-gray-2);
  }
  :root[data-theme='light'] {
    .header a:hover {
      color: var(--sl-color-gray-3);
    }
  }

  .desktop {
    display: none;
    align-items: center;
    gap: 1rem;
    padding-inline-end: 1rem;
  }
  @media (width > 50rem) {
    .desktop {
      display: flex;
    }
    .mobile {
      display: none;
    }
  }
</style>

<style is:global>
  .header {
    border: none !important;
  }
  body[data-mobile-menu-expanded] header {
    background-color: var(--sl-color-bg);
  }

  @media (width <= 50rem) {
    header {
      /* We always show the sidebar on mobile */
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }
  }

  .title-wrapper img {
    height: 2rem;
  }
</style>
