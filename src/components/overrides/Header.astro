---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';

const curLocale = Astro.locals.starlightRoute.locale;
const { topics } = Astro.locals.starlightSidebarTopics;

type Link = {
  title: string;
  value: string;
  transfer: boolean;
};

const links: Link[] = [
  {
    title: 'Guides',
    value: '/start/',
    transfer: true,
  },
  {
    title: 'References',
    value: '/reference/cli/',
    transfer: true,
  },
  {
    title: 'Blog',
    value: '/blog/',
    transfer: false,
  },
  {
    title: 'Releases',
    value: '/release/',
    transfer: true,
  },
];
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="desktop">
    {
      links.map((link) => {
        const href = link.transfer && curLocale ? `/${curLocale}${link.value}` : link.value;
        const current = topics.find((topic) => topic.isCurrent && topic.link === href);
        return (
          <a href={href} class:list={{ 'starlight-sidebar-topics-current': current }}>
            {link.title}
          </a>
        );
      })
    }
  </div>
  <div class="sl-hidden md:sl-flex right-group">
    <div class="sl-flex search">
      <Search />
    </div>
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
  </div>
</div>

<style>
  .header {
    display: grid;
    gap: var(--sl-nav-gap);
    align-items: center;
    grid-template-columns: auto 1fr auto;
  }

  .title-wrapper {
    /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
    overflow: clip;
    /* Avoid clipping focus ring around link inside title wrapper. */
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .search,
  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .search::after,
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }
  a.starlight-sidebar-topics-current {
    color: var(--sl-color-text-accent);
  }
  a:hover {
    color: var(--sl-color-gray-2);
  }
  :root[data-theme='light'] {
    .header a:hover {
      color: var(--sl-color-gray-3);
    }
  }

  .desktop {
    display: none;
    align-items: center;
    gap: 1rem;
    padding-inline-end: 1rem;
  }
  @media (width > 72rem) {
    .desktop {
      display: flex;
    }
    .mobile {
      display: none;
    }
  }
</style>

<style is:global>
  .header {
    border: none !important;
  }
  body[data-mobile-menu-expanded] header {
    background-color: var(--sl-color-bg);
  }
</style>
