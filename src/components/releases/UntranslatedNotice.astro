---
// used for release pages (no /{locale}/release page)
import ContentNotice from '@astrojs/starlight/components/ContentNotice.astro';
import { useTranslations } from '@astrojs/starlight/internal';
import locales from '../../../locales.json';

const labels = Object.fromEntries(
  Object.entries(locales)
    .filter(([code]) => code !== 'root')
    .map(([code, locale]) => [code, useTranslations(locale.lang)('i18n.untranslatedContent')])
);
---

<div data-untranslated-labels={JSON.stringify(labels)} hidden>
  <ContentNotice icon="warning" label="" />
</div>

<script>
  import { readRememberedLocale } from '../locale-memory';
  import { applyReleaseLocale } from './release-locale';

  applyReleaseLocale(readRememberedLocale());
</script>
