---
import { Code } from '@astrojs/starlight/components';
import CommandTabs from '../CommandTabs.astro';
import ShowSolution from '../ShowSolution.astro';
import { fileBlocks, type FileBlock } from './derive';
import { getStep } from './manifests';

interface Props {
  /** tutorial id matching `src/data/tutorials/<id>/manifest.json` */
  tutorial: string;
  /** step id inside that tutorial's manifest */
  step: string;
  /** hide the recorded code behind a Show-solution toggle (lab pages) */
  solution?: boolean;
}

const { tutorial, step, solution = false } = Astro.props;
// throws on unknown tutorial/step, failing the build, because drift between
// prose and manifest is exactly what this component exists to catch
const record = getStep(tutorial, step);

// Shiki resolves extensions and aliases (`rs` → rust) natively; site-wide
// remaps belong in `shiki.langAlias` in astro.config.mjs
function langOf(file: string): string {
  return file.split('.').pop() ?? 'txt';
}

type Block =
  FileBlock | { kind: 'command'; code: string } | { kind: 'js-install'; pkg: string; code: string };

// Expressive Code applies diff-like rendering (marker stripping, ins/del
// backgrounds, `lang` meta highlighting) only when the block is not a full
// unified diff, which is why derive.ts hands back bare hunk bodies. One block
// per hunk, because joining hunks silently glues disjoint regions.
const blocks = record.mutations.flatMap((m): Block[] => {
  if (m.file) return fileBlocks(tutorial, step, m.file, langOf(m.file));
  if (m.command) {
    // the runner records the one package manager that actually ran; a plain
    // JS-package install is presentation-equivalent across managers, so it
    // renders as the usual manager tabs instead of a pnpm-only line
    const pkg = m.command.match(/^pnpm add (\S+)$/)?.[1];
    if (pkg) return [{ kind: 'js-install', pkg, code: m.command }];
    return [{ kind: 'command', code: m.command }];
  }
  return [];
});
---

<slot />

{
  (() => {
    const rendered = blocks.map((b) =>
      b.kind === 'command' ? (
        <Code code={b.code} lang="sh" frame="none" />
      ) : b.kind === 'js-install' ? (
        <CommandTabs
          npm={`npm install ${b.pkg}`}
          yarn={`yarn add ${b.pkg}`}
          pnpm={b.code}
          deno={`deno add npm:${b.pkg}`}
          bun={`bun add ${b.pkg}`}
        />
      ) : b.kind === 'file' ? (
        <Code code={b.code} lang={b.lang} title={b.title} />
      ) : (
        <Code code={b.code} lang="diff" meta={`lang="${b.lang}"`} title={b.title} />
      )
    );
    return solution && rendered.length > 0 ? <ShowSolution>{rendered}</ShowSolution> : rendered;
  })()
}
