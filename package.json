{
  "name": "tauri-docs",
  "type": "module",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "scripts": {
    "dev:setup:submodules": "git submodule update --init",
    "dev:setup:tauri": "pnpm install -C packages/tauri/packages/api --ignore-workspace --no-frozen-lockfile",
    "dev:setup:plugins-workspace": "pnpm -C packages/plugins-workspace install",
    "dev:setup": "pnpm dev:setup:submodules && pnpm dev:setup:tauri && pnpm dev:setup:plugins-workspace && pnpm build:compatibility-table",
    "sync:sponsors": "pnpm --filter fetch-sponsors run build sponsors",
    "sync:contributors": "pnpm --filter fetch-sponsors run build contributors",
    "dev": "astro dev",
    "format": "prettier -w --cache --plugin prettier-plugin-astro .",
    "format:check": "prettier -c --cache --plugin prettier-plugin-astro .",
    "check": "astro check",
    "build:compatibility-table": "pnpm --filter compatibility-table run build",
    "build:config": "pnpm --filter config-generator run build",
    "build:cli": "pnpm --filter cli-generator run build",
    "build:astro": "astro build",
    "build": "pnpm dev:setup && pnpm build:config && pnpm build:cli && pnpm build:astro",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "catalog:",
    "@lunariajs/core": "^0.1.1",
    "@lunariajs/starlight": "^0.1.1",
    "@types/mdast": "^4.0.4",
    "astro": "catalog:",
    "astro-d2": "^0.13.0",
    "astrojs-service-worker": "^2.0.2",
    "mdast-util-definitions": "^6.0.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.2",
    "sass": "^1.89.0",
    "sharp": "^0.35.3",
    "starlight-blog": "^0.28.0",
    "starlight-links-validator": "^0.25.2",
    "starlight-llms-txt": "^0.11.0",
    "starlight-sidebar-topics": "^0.8.0",
    "starlight-typedoc": "^0.23.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "unified": "^11.0.5",
    "vite": "^8.1.4",
    "tauri-typedoc": "workspace:*"
  },
  "minimumReleaseAge": 4320,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "pnpm": "^10.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
