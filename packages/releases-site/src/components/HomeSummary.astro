---
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { repositories } from '../../generator/config';
import { latestVersions } from '../../generator/generated/latestVersions';
import { buildHomeSummaryRepos, renderVersionPill } from '../../generator/uiData';

const repos = buildHomeSummaryRepos(repositories, latestVersions);

function describe(pkg: (typeof repos)[number]['packages'][number]): string {
  const pills = pkg.versions
    .map(({ label, version, href }) => renderVersionPill(label, version, href))
    .join('');
  const date = pkg.latestReleaseDateLabel
    ? `<small class="release-date">${pkg.latestReleaseDateLabel}</small>`
    : '';
  const meta = pills || date ? `<span class="card-meta version-meta-row">${pills}${date}</span>` : '';
  return `${pkg.description}${meta}`;
}
---

{
  repos.map((repo) => (
    <section class="repo-summary">
      <h2 id={repo.displayName.toLowerCase().replaceAll(' ', '-')}>
        {repo.displayName}
        <a class="repo-link" href={repo.repoUrl} target="_blank" rel="noopener noreferrer">
          {repo.repoSlug}
        </a>
      </h2>
      <CardGrid>
        {repo.packages.map((pkg) => (
          <LinkCard title={pkg.name} href={`/release/${pkg.name}/`} description={describe(pkg)} />
        ))}
      </CardGrid>
    </section>
  ))
}

<style>
  .repo-summary h2 {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .repo-link {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    font-weight: 400;
    text-decoration: none;
  }

  .repo-link:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }

  .repo-summary :global(.sl-link-card) {
    padding-bottom: 3em;
  }

  .repo-summary :global(.sl-link-card .description) {
    font-size: var(--sl-text-sm);
  }

  .repo-summary :global(.card-meta) {
    position: absolute;
    inset-inline: 1rem;
    bottom: 0.75rem;
  }
</style>
